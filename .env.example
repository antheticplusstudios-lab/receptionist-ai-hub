# Browser-safe DB1 auth values (never put service keys here)
VITE_DB1_URL=https://YOUR-DB1-AUTH.supabase.co
VITE_DB1_ANON_KEY=YOUR_DB1_PUBLISHABLE_OR_ANON_KEY
VITE_APP_URL=https://app.antheticplus.com
VITE_API_GATEWAY_URL=https://api.antheticplus.com

# Server-only database service credentials
DB1_URL=https://YOUR-DB1-AUTH.supabase.co
DB1_ANON_KEY=YOUR_DB1_PUBLISHABLE_OR_ANON_KEY
DB1_SERVICE_KEY=YOUR_DB1_SERVICE_ROLE_KEY
DB2_URL=https://YOUR-DB2-BILLING.supabase.co
DB2_SERVICE_KEY=YOUR_DB2_SERVICE_ROLE_KEY
DB3_URL=https://YOUR-DB3-AI.supabase.co
DB3_SERVICE_KEY=YOUR_DB3_SERVICE_ROLE_KEY
DB4_URL=https://YOUR-DB4-CRM.supabase.co
DB4_SERVICE_KEY=YOUR_DB4_SERVICE_ROLE_KEY
ANTHETICPLUS_DB3_MASTER_KEY=BASE64_32_BYTE_KEY
REDIS_URL=redis://localhost:6379/0
FASTAPI_BACKEND_URL=https://api.antheticplus.com
FASTAPI_WS_URL=wss://api.antheticplus.com
NITRO_PRESET=vercel

# Widget origins: exact roots; each root also allows its subdomains. Add your Vercel host now and your custom domain later.
ALLOWED_WIDGET_HOSTS=antheticplus.vercel.app,antheticplus.com
